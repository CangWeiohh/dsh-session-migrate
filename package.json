{
  "name": "dsh-session-migrate",
  "version": "0.1.0",
  "description": "Safely prepare and execute offline DeepSeek Harness session migrations between registered workspaces.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./migration-core": "./lib/migration-core.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-session-migrate": "./bin/migrate-session.mjs"
  },
  "files": [
    "src",
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/client.js && node --check lib/migration-core.mjs && node --check bin/migrate-session.mjs && node --test test/*.test.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "workspace",
    "migration"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
